# Имя Compose-проекта и одновременно безопасный идентификатор роутера Traefik.
PROJECT_NAME=tutu-swipe

# Тег уже собранного локально и перенесённого на VPS образа.
APP_IMAGE=tutu-swipe:latest

# Жёсткий лимит RAM защищает соседние контейнеры на VPS от всплесков приложения.
# Для изменения задайте другое значение в серверном .env и пересоздайте контейнер.
APP_MEMORY_LIMIT=320m

# Внутренний порт Node.js; наружу он не публикуется, доступ идёт через Traefik.
APP_PORT=3000

# Публичный домен без схемы и пути.
APP_DOMAIN=tutu-swipe.185.79.138.118.nip.io

# HMAC-секрет сессии. Сгенерируйте: openssl rand -base64 32
# Значение храните только в локальном .env или secret store сервера.
SESSION_STATE_SECRET=

# Шаблон секретов. Скопируй в .env.local и заполни.
# .env.local в .gitignore — секреты не коммитятся.
#
# ── Пример секции ───────────────────────────────────────────────────────────
# SOME_API_KEY=            # откуда взять: https://example.com/dashboard

# HMAC-подпись клиентского состояния сессии. Только серверная переменная:
# сгенерируй 32 случайных байта командой `openssl rand -base64 32` и сохрани
# результат только в .env.local или в секретах окружения деплоя.
SESSION_STATE_SECRET=
